{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "npm --workspace @puckeditor/core run build && npm exec --yes turbo run dev",
    "lint": "turbo run lint",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx,css}\"",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,css}\"",
    "release": "npm run release:prepare && npm run changelog && npm run release-commit",
    "release:prepare": "git fetch --tags && conventional-recommended-bump -p angular | xargs -I {} npm run version:auto -- {}",
    "release:canary": "npm run release:prepare && node scripts/get-unstable-version canary | xargs -I {} npm run version:auto -- {}",
    "release-commit": "git add -u && git commit -m \"release: v${npm_package_version}\"",
    "smoke": "node scripts/e2e/smoke.mjs",
    "test": "turbo run test",
    "version": "lerna version --force-publish -y --no-push --no-changelog --no-git-tag-version $npm_package_version",
    "version:auto": "npm version $1 --no-git-tag-version",
    "changelog": "node scripts/create-changelog"
  },
  "devDependencies": {
    "@turbo/gen": "^2.3.3",
    "asciichart": "^1.5.25",
    "conventional-changelog-angular": "^4.0.0",
    "conventional-recommended-bump": "^6.0.5",
    "eslint": "^7.32.0",
    "eslint-config-custom": "0.0.0",
    "lerna": "^9.0.0",
    "prettier": "^2.5.1",
    "puppeteer": "^24.8.2",
    "rimraf": "^6.1.2",
    "standard-changelog": "^2.0.21",
    "turbo": "^2.5.8"
  },
  "name": "puck-repo",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "recipes/*",
    "packages/*"
  ],
  "version": "0.21.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
